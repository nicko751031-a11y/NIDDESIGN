{
  "name": "nid-timeclock",
  "version": "1.0.0",
  "private": true,
  "description": "川果設計 NID DESIGN LAB LINE 打卡系統（符合勞基法第30條出勤紀錄要求）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute nid-timeclock --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute nid-timeclock --local --file=./schema.sql",
    "db:backup": "wrangler d1 export nid-timeclock --remote --output=./backup-$(date +%Y%m%d).sql",
    "test": "node test/run.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
