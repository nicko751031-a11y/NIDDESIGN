# 複製成 .env 並填入實際值。.env 已被 .gitignore 排除，絕對不要 commit。
#
# n8n 公開 API（scripts/n8n 會讀這兩個）
# 產生方式：n8n UI → 右下角帳號 → Settings → n8n API → Create an API key
N8N_API_KEY=
N8N_BASE_URL=https://n8n-production-65dca.up.railway.app

# LINE Messaging API（scripts/line 會讀）
# 取得：https://developers.line.biz/console/channel/2010874992/messaging-api
# ⚠️ 不要按 Reissue 重新產生，會讓 n8n 現用的那把失效。複製既有的即可。
LINE_CHANNEL_ACCESS_TOKEN=

# 送出類 LINE 操作的安全開關。留空或 0 = 只演練不送出（建議維持）。
# 要真的推播時，在單次指令前面加 LINE_ALLOW_SEND=1，不要設成環境預設值。
LINE_ALLOW_SEND=

# Notion（查訊息紀錄與檔案索引；agent 讀資料主要靠這個）
NOTION_TOKEN=

# 以下是 n8n 執行環境（Railway）已設定的變數，本機開發或搬家時才需要。
# 不要放進 repo，也不要寫進工作流 JSON。
LINE_CHANNEL_SECRET=
ANTHROPIC_API_KEY=
