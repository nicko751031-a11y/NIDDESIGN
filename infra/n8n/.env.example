# ============================================================
# 川果設計 NID DESIGN LAB｜自架 n8n 環境變數
# 複製成 .env 後填寫。.env 已被 .gitignore 排除，絕對不要提交進版控。
# ============================================================

# --- 對外網域（要先在 DNS 把這個名字 A 記錄指到本台 VPS 的 IP）---
N8N_HOST=n8n.niddesignlab.com

# --- Let's Encrypt 憑證通知信箱 ---
ACME_EMAIL=nicko751031@gmail.com

# --- n8n 憑證加密金鑰 ---
# 用 openssl rand -hex 32 產生。遺失＝n8n 內所有已存憑證全部失效，請離線備份。
N8N_ENCRYPTION_KEY=

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# --- LINE Messaging API ---
# Channel Secret 用於驗證 Webhook 簽章（工作流的 Code 節點會讀這個變數）。
# 取得位置：LINE Developers Console → Messaging API Channel → Basic settings
LINE_CHANNEL_SECRET=

# 系統出錯時推播通知的對象（管理者 LINE User ID，或公司內部群組的 Group ID）
# 留空則「02｜錯誤通知」工作流不會發送。User ID 可從 01 工作流的執行紀錄取得。
N8N_ALERT_LINE_TARGET=

# --- Notion 資料庫 ID（已建立完成，通常不用改）---
NOTION_DB_GROUPS=e8151c00-4fdb-4496-8b04-5b91b6cc018d
NOTION_DB_FILES=32903708-fccf-48a0-b219-767da737f0ea
NOTION_DB_MESSAGES=687c5006-5421-4692-a9d9-5ff390a9c55a

# 註：以下密鑰「不放這裡」，改在 n8n 介面建立成 Credential，
#     這樣匯出工作流 JSON 時不會夾帶密鑰：
#       - LINE Channel Access Token  → Header Auth
#       - Anthropic API Key          → Header Auth
#       - Notion Integration Token   → Header Auth
#       - Dropbox                    → Dropbox OAuth2 API
